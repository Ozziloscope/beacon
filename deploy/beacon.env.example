# Beacon settings, read by beacon.service from /etc/beacon/beacon.env.
# Upgrades never overwrite that file. After editing it:  systemctl restart beacon

# Address to listen on. 127.0.0.1 when cloudflared runs in this container;
# 0.0.0.0 when the tunnel runs somewhere else on your LAN.
BEACON_HOST=127.0.0.1
BEACON_PORT=3000

# Database, photos and avatars. Never delete this directory.
BEACON_DATA_DIR=/var/lib/beacon

# Trust Cloudflare's forwarded headers for client IPs and https detection.
BEACON_TRUST_PROXY=1

# Optional
#BEACON_SESSION_DAYS=30
#BEACON_MAX_UPLOAD_MB=15
