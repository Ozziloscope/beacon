[Unit]
Description=Beacon wiki
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
WorkingDirectory=/opt/beacon
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/beacon/server.js
Environment=NODE_ENV=production
# Your settings (host, port, data directory…) live in /etc/beacon/beacon.env.
# The installer creates that file once and never overwrites it on upgrades.
EnvironmentFile=/etc/beacon/beacon.env
Restart=on-failure
RestartSec=3

# Hardening: the app only needs to write its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/beacon
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
